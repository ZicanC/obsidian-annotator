{
  "compilerOptions": {
    "baseUrl": "src",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "es6",
    "allowJs": true,
    "noImplicitAny": false,
    "moduleResolution": "node",
    "esModuleInterop":true,
    "importHelpers": true,
    "noEmit": true,
    "types": [
      "node",
      "jest"
    ],
    "allowSyntheticDefaultImports": true,
    "lib": [
      "dom",
      "es5",
      "scripthost",
      "es2015",
      "DOM.Iterable",
      "ESNext"
    ],
    "jsx": "react",
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"],
  "exclude": [
    "node_modules",
    "submodules"
  ]
}
